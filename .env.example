# Copy to .env and fill in your Discord bot token.
# The bot must run on the SAME PC as TikFinity for LIVE detection.

DISCORD_TOKEN=your_bot_token_here

# TikFinity Event API (Desktop App → local WebSocket)
TIKFINITY_WS_URL=ws://localhost:21213/

# Discord #general channel ID (numeric). Falls back to GENERAL_CHANNEL_ID if omitted.
DISCORD_LIVE_CHANNEL_ID=781379162002030594

TIKTOK_LIVE_URL=https://www.tiktok.com/@GFerryGoon
TWITCH_LIVE_URL=https://www.twitch.tv/gferrygoon

# Optional. Leave unset while identifying the real LIVE-start event from logs.
# Do not set this to "connected" — that only means the bot reached TikFinity.
# TIKFINITY_LIVE_START_EVENTS=
